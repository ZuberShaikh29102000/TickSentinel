# Copy to .env (scripts/setup.sh does this and generates a random password).
# .env is gitignored; never commit real credentials.

# --- Production (Render): the Supabase connection string, set in the Render ---
# dashboard, NOT here. Use Supabase's "Session pooler" URL: Supabase's free direct
# connection is IPv6-only, while the session pooler works over IPv4 and still
# supports prepared statements (which asyncpg uses). When set, it overrides the
# local POSTGRES_* settings below.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# --- Local Postgres (read by docker-compose and by the Python services) ---
POSTGRES_HOST=localhost
# 5433 on the host so we don't collide with a locally installed Postgres on 5432.
POSTGRES_PORT=5433
POSTGRES_USER=ticksentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticksentinel

# --- AI investigation (Phase 4+) ---
ANTHROPIC_API_KEY=
